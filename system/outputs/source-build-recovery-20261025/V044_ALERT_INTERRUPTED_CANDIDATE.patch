+// AggrGroupsSnapshot is a snapshot of the dispatcher's aggregation-group state.
+type AggrGroupsSnapshot struct {
+	aggrGroupsPerRoute map[*Route]map[model.Fingerprint]*aggrGroup
+	aggrGroupsNum      int
+}
+
+// SnapshotAggrGroups returns a snapshot of the current aggregation-group state
+// under the dispatcher lock, so it can be handed to a replacement dispatcher
+// during a configuration reload.
+func (d *Dispatcher) SnapshotAggrGroups() *AggrGroupsSnapshot {
+	if d == nil {
+		return nil
+	}
+	d.mtx.RLock()
+	defer d.mtx.RUnlock()
+
+	snapshot := &AggrGroupsSnapshot{
+		aggrGroupsPerRoute: make(map[*Route]map[model.Fingerprint]*aggrGroup, len(d.aggrGroupsPerRoute)),
+		aggrGroupsNum:      d.aggrGroupsNum,
+	}
+	for route, groups := range d.aggrGroupsPerRoute {
+		routeGroups := make(map[model.Fingerprint]*aggrGroup, len(groups))
+		for fp, ag := range groups {
+			routeGroups[fp] = ag
+		}
+		snapshot.aggrGroupsPerRoute[route] = routeGroups
+	}
+	return snapshot
+}
+
+// SetAggrGroupsSnapshot installs a previously captured aggregation-group
+// snapshot into the dispatcher. It must be called before Run so that Run's
+// initialization does not discard the preserved groups.
+func (d *Dispatcher) SetAggrGroupsSnapshot(snapshot *AggrGroupsSnapshot) {
+	if d == nil || snapshot == nil {
+		return
+	}
+	d.mtx.Lock()
+	defer d.mtx.Unlock()
+
+	currentRoutes := make(map[string]*Route)
+	d.route.Walk(func(r *Route) {
+		currentRoutes[r.Key()] = r
+	})
+
+	d.aggrGroupsPerRoute = make(map[*Route]map[model.Fingerprint]*aggrGroup, len(snapshot.aggrGroupsPerRoute))
+	for route, groups := range snapshot.aggrGroupsPerRoute {
+		current, ok := currentRoutes[route.Key()]
+		if !ok {
+			continue
+		}
+		routeGroups := make(map[model.Fingerprint]*aggrGroup, len(groups))
+		for fp, ag := range groups {
+			routeGroups[fp] = ag
+		}
+		d.aggrGroupsPerRoute[current] = routeGroups
+	}
+	d.aggrGroupsNum = snapshot.aggrGroupsNum
+	if d.metrics != nil {
+		d.metrics.aggrGroups.Set(float64(d.aggrGroupsNum))
+	}
+}
+
