+// findConfigResource returns the resource in input that belongs to pn's package
+// and whose file path matches configPath, or nil if no such resource exists.
+func findConfigResource(pn *pkgNode, input []*yaml.RNode, configPath string) *yaml.RNode {
+	for _, r := range input {
+		pkgPath, err := pkg.GetPkgPathAnnotation(r)
+		if err != nil {
+			continue
+		}
+		currPath, _, err := kioutil.GetFileAnnotations(r)
+		if err != nil {
+			continue
+		}
+		if pkgPath == pn.pkg.UniquePath.String() && currPath == configPath {
+			return r
+		}
+	}
+	return nil
+}
+
+// excludeResource returns a new slice containing all resources from input except
+// the given resource, preserving the original order.
+func excludeResource(input []*yaml.RNode, exclude *yaml.RNode) []*yaml.RNode {
+	var result []*yaml.RNode
+	for _, r := range input {
+		if r != exclude {
+			result = append(result, r)
+		}
+	}
+	return result
+}
