+// excludeConfigPath removes the resource designated by configPath from the
+// given resource list. The configPath resource is supplied to its owning
+// function as functionConfig and must not also be treated as an ordinary input
+// item. Resources are matched by package path and file path annotations, the
+// same identity used by refreshFnConfig.
+func (pn *pkgNode) excludeConfigPath(input []*yaml.RNode, configPath string) []*yaml.RNode {
+	var result []*yaml.RNode
+	for _, r := range input {
+		pkgPath, err := pkg.GetPkgPathAnnotation(r)
+		if err != nil {
+			result = append(result, r)
+			continue
+		}
+		currPath, _, err := kioutil.GetFileAnnotations(r)
+		if err != nil {
+			result = append(result, r)
+			continue
+		}
+		if pkgPath == pn.pkg.UniquePath.String() && currPath == configPath {
+			continue
+		}
+		result = append(result, r)
+	}
+	return result
+}
