{
  "provider": "openai_compatible",
  "base_url": "https://api.deepseek.com",
  "api_key_env": "DEEPSEEK_API_KEY",
  "model": "deepseek-flash",
  "model_identity_policy": "require_match",
  "tokenizer": "contractedge.development.public_demo:count_tokens",
  "output_mode": "json_object",
  "supports_json_schema": false,
  "schema_fallback": "error",
  "schema_in_prompt": true,
  "thinking": "disabled",
  "model_context_tokens": 1000000,
  "max_context_tokens": 100000,
  "max_output_tokens": 8192,
  "max_total_tokens": 500000,
  "max_elapsed_seconds": 900,
  "max_model_calls": 6,
  "max_rounds": 1,
  "max_format_retries": 1,
  "timeout_seconds": 180,
  "money_budget": {
    "path": "outputs/deepseek-official-development-money.json",
    "limit_cny": "30",
    "model": "deepseek-flash",
    "input_cny_per_million": "3",
    "output_cny_per_million": "12"
  }
}
