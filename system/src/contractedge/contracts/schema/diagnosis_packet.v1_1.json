{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractEdge DiagnosisPacket v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "input_digest",
    "requirement_spec",
    "requirement_horizon",
    "observed_boundary",
    "inferred_causal_path",
    "unverified_outcomes",
    "obligation_atoms",
    "units",
    "expected_relations",
    "violations",
    "outcome_coverage",
    "evidence_refs",
    "evidence_gaps",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "ce.diagnosis_packet.v1_1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "$ref": "#/$defs/digest"
    },
    "requirement_spec": {
      "type": "object"
    },
    "requirement_horizon": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_boundary": {
      "type": "string"
    },
    "inferred_causal_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "obligation_atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligationAtom"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "expected_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "outcome_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceGap"
      }
    },
    "status": {
      "enum": [
        "READY",
        "PARTIAL_READY",
        "EVIDENCE_GAP",
        "NO_SUPPORTED_VIOLATION",
        "INVALID_OUTPUT"
      ]
    },
    "clause_treatments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "disposition",
          "obligation_refs",
          "rationale"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "OBLIGATION",
              "BACKGROUND",
              "UNCERTAIN"
            ]
          },
          "obligation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "obligation_lineage": {
      "type": "object",
      "required": [
        "schema_version",
        "input_digest",
        "requirement_digest",
        "nodes",
        "events",
        "bindings",
        "snapshot_id"
      ],
      "properties": {
        "schema_version": {
          "const": "ce.obligation_lineage.v1"
        },
        "input_digest": {
          "type": "string"
        },
        "requirement_digest": {
          "type": "string"
        },
        "nodes": {
          "type": "object"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "snapshot_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lineage_events": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "parent_ids",
          "atom_refs",
          "rationale"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CONTINUE",
              "REANCHOR",
              "SPLIT",
              "MERGE"
            ]
          },
          "parent_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "atom_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "interpretation_disputed": {
            "type": "boolean",
            "description": "Challenge a prior derived interpretation on CONTINUE or REANCHOR; history stays visible and the original public requirement stays unresolved."
          }
        }
      }
    },
    "operation_assessments": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "disposition",
          "outcome_refs",
          "rationale"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "REQUIRES_SUCCESS",
              "EXPECTED_EXCEPTION",
              "UNRELATED",
              "UNKNOWN"
            ]
          },
          "outcome_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "satisfaction": {
            "enum": [
              "SATISFIED",
              "UNSATISFIED",
              "UNKNOWN"
            ]
          },
          "exception_type": {
            "type": "string"
          },
          "contract_ref": {
            "type": "string"
          },
          "contract_quote": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "scope_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "obligationAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome_id",
        "statement",
        "source_refs",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[1-9][0-9]*$"
        },
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "support": {
          "enum": [
            "EXPLICIT",
            "DERIVED"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "stable_obligation_key": {
          "type": "string"
        },
        "scope_quote": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "kind",
        "semantic_role_class",
        "existence",
        "locator_refs",
        "requirement_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "semantic_role_class": {
          "enum": [
            "CONFIGURATION_INPUT",
            "PRODUCTION_CONSUMER",
            "GENERATED_STATE",
            "RUNTIME_CONSUMER",
            "OBSERVED_STATE",
            "TEST_ARTIFACT",
            "OTHER"
          ]
        },
        "existence": {
          "enum": [
            "PRESENT",
            "EXPECTED_MISSING",
            "UNKNOWN"
          ]
        },
        "locator_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_unit_ids",
        "target_unit_ids",
        "relation_form",
        "shared_constraint_reason",
        "mechanism",
        "condition",
        "expected_contract",
        "requirement_refs",
        "obligation_refs",
        "support_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target_unit_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "relation_form": {
          "enum": [
            "DIRECT_EDGE",
            "INDIVISIBLE_SHARED"
          ]
        },
        "shared_constraint_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_contract": {
          "type": "string",
          "minLength": 1
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obligation_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^A[1-9][0-9]*$"
          }
        },
        "support_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relation_id",
        "broken_behavior",
        "causal_explanation",
        "evidence_refs",
        "support_basis",
        "causal_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "broken_behavior": {
          "type": "string",
          "minLength": 1
        },
        "causal_explanation": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_basis": {
          "enum": [
            "OBSERVED_AND_STATIC",
            "STATIC_INFERENCE",
            "OBSERVED_ONLY"
          ]
        },
        "causal_status": {
          "enum": [
            "SUPPORTED",
            "TENTATIVE"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "repair_supported",
        "preserve_required",
        "preserve_current_satisfaction",
        "unresolved"
      ],
      "properties": {
        "outcome_id": {
          "type": "string"
        },
        "repair_supported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserve_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserve_current_satisfaction": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preserveSatisfaction"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "preserveSatisfaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "outcome_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "OBSERVED",
            "INFERRED",
            "UNKNOWN"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "snapshot_id",
        "kind",
        "locator",
        "content_digest",
        "excerpt",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "REQUIREMENT_TEXT",
            "SOURCE_SPAN",
            "SOURCE_INVENTORY",
            "STATIC_SEARCH",
            "PUBLIC_OBSERVATION",
            "DECLARED_ARTIFACT"
          ]
        },
        "locator": {
          "type": "object"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "excerpt": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "EXECUTION_ONLY",
            "PUBLIC_STRUCTURE",
            "PUBLIC_BEHAVIOR"
          ]
        },
        "scenario": {
          "type": "string"
        },
        "resource_identity": {
          "type": "object"
        },
        "behavior_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status",
            "probe_sha256"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "probe_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "source_pointer": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "source_file_sha256": {
          "type": "string"
        },
        "adapter_id": {
          "type": "string"
        },
        "producer_manifest_sha256": {
          "type": "string"
        },
        "structured_complete": {
          "type": "boolean"
        }
      }
    },
    "evidenceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "locator_hint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "locator_hint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search_term": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            }
          },
          "anyOf": [
            {
              "required": [
                "search_term"
              ]
            },
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "symbol"
              ]
            }
          ]
        }
      }
    }
  }
}
